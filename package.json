{
  "name": "dskd",
  "version": "9.27.0",
  "private": true,
  "description": "oti による個人ウェブサイト『dskd』の原稿とテンプレート",
  "keywords": [],
  "license": "CC BY-NC",
  "author": "oti",
  "type": "module",
  "scripts": {
    "build": "dskdius build",
    "create-draft-post": "dskdius draft",
    "html": "dskdius build --only-html",
    "prebuild": "rm -rf dist",
    "start": "npm run build && cd dist && python3 -m http.server 3000",
    "test:css": "npx stylelint 'dist/**/*.css'",
    "test:html": "npx markuplint 'dist/**/*.html'",
    "test": "npm run test:css && npm run test:html"
  },
  "devDependencies": {
    "dskdius": "file:../dskdius"
  }
}
