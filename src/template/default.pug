-
  const isHome = type === "home"
  const isPage = type === "page"
  const isPost = type === "post"
  const isTag = type === "tag"
  const isYear = type === "year"
  const isPostIndex = type === "posts"
  const metaTitle = isHome ? site.name : `${title} - ${site.name}`
  const description = isHome
    ? site.desc
    : isPostIndex
    ? `${site.name} の全記事一覧`
    : isTag
    ? `${title}タグの記事一覧`
    : isYear
    ? `${title}年の記事一覧`
    : desc
  const canonical = isHome
    ? site.url
    : isPage
    ? `${site.url}${U.page}${id}.html`
    : isPost
    ? `${site.url}${U.post}${id}.html`
    : isTag
    ? `${site.url}${U.tag}${slug(title)}.html`
    : isYear
    ? `${site.url}${U.year}${title}.html`
    : site.url

  const ogImage = cover ? cover : site.extra.ogp

include mixin/publish

doctype html
html.-no-js(lang=site.lang)
  head
    meta(charset="UTF-8")
    meta(content="viewport-fit=cover, width=device-width", name="viewport")
    title= metaTitle
    meta(content=description, name="description")
    link(rel="image_src", href=`${ogImage}?${site.version}`)
    link(
      rel="icon",
      href=`${site.extra.favicon}?${site.version}`,
      type="image/svg+xml"
    )
    link(
      rel="apple-touch-icon",
      sizes="180x180",
      href=`${site.extra.touchIcon}?${site.version}`
    )
    link(
      href=`/style/style.css?${site.version}`,
      rel="stylesheet",
      media="only screen"
    )
    link(href=U.feed, rel="alternate", type="application/rss+xml")
    link(href=canonical, rel="canonical")
    include _script

  body
    header.Header
      if isPost || isPage
        nav
          include _logo
      else
        h1
          include _logo
      details.Mode
        summary カラーモード
        form#Switch
          label
            input(name="switch", type="radio", value="-system")
            span OS
          label
            input(name="switch", type="radio", value="-light")
            span ライト
          label
            input(name="switch", type="radio", value="-dark")
            span ダーク

    main
      block main

    footer.Border
      .Halve
        ul.Pages
          each page in pages
            - const cr = id === page.id;
            li
              a(
                href=`${U.page}${page.id}.html`,
                class=cr && "-current",
                aria-current=cr && "page",
                rel=cr && "author"
              )= page.title
          li
            a(href=`${site.url}${U.feed}`, target="_blank") RSS

        p.License
          span © #{site.author}
          a(
            href="https://creativecommons.org/licenses/by-nc/4.0/deed.ja",
            rel="license"
          ) CC BY-NC

      .Nav.Halve
        button#Back.BackButton
          span(aria-hidden="true") #
          | back

        a(href="#top")
          span(aria-hidden="true") #
          | top
