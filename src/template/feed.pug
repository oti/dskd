doctype xml
rss(
  version="2.0",
  xmlns:atom="http://www.w3.org/2005/Atom",
  xmlns:content="http://purl.org/rss/1.0/modules/content/",
  xmlns:creativeCommons="http://blogs.law.harvard.edu/tech/creativeCommonsRssModule"
)
  channel
    title= site.name
    link= site.url
    description= `<![CDATA[${site.desc}]]>`
    language ja-JP
    pubdate= new Date()
    lastbuilddate= new Date()
    docs http://blogs.law.harvard.edu/tech/rss
    generator= site.extra.authorEn
    managingeditor
    webmaster= `${site.author} ${site.email}`
    atom:link(
      href=`${site.url}${U.feed}`,
      rel="self",
      type="application/rss+xml"
    )/
    creativeCommons:license https://creativecommons.org/licenses/by-nc/4.0/deed.ja

    each post, i in posts
      item
        title= post.title
        link= `${site.url}${U.post}${post.id}.html`
        description= post.desc
        pubdate= new Date(post.datetime)
        guid(isPermaLink="true")= `${site.url}${U.post}${post.id}.html`
        //- content:encoded=('<![CDATA['+post.content+']]>')
